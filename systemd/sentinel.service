[Unit]
Description=Sentinel Portfolio Management
After=clara-box.service
Requires=clara-box.service

[Service]
Type=simple
TimeoutStartSec=900
ExecStartPre=-/usr/bin/podman exec --user aristath --env HOME=/var/home/aristath -w /var/home/aristath clara bash -lc 'cd /var/home/aristath/sentinel && git fetch origin main'
ExecStartPre=/usr/bin/podman exec --user aristath --env HOME=/var/home/aristath -w /var/home/aristath clara bash -lc 'cd /var/home/aristath/sentinel && git reset --hard origin/main && uv sync --locked'
ExecStart=/usr/bin/podman exec --user aristath --env HOME=/var/home/aristath -w /var/home/aristath clara bash -lc 'cd /var/home/aristath/sentinel && exec .venv/bin/python main.py --host 0.0.0.0'
ExecStopPost=/usr/bin/podman exec --user aristath --env HOME=/var/home/aristath -w /var/home/aristath clara bash -lc 'fuser -k 8000/tcp 2>/dev/null || true'
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
